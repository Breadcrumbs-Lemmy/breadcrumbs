# Breadcrumbz web — Vite build served by nginx.
#
# Vite inlines `VITE_*` variables at BUILD time, not run time. The API URL is
# therefore a build argument, and changing it means rebuilding the image. This
# is a property of the bundler, not a choice — and it is also the reason no
# secret may ever carry a `VITE_` prefix: it would be published in plain text
# to every visitor.

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml ./
COPY pnpm-lock.yaml* ./
COPY packages/core/package.json packages/core/
COPY packages/server/package.json packages/server/
COPY apps/web/package.json apps/web/
RUN pnpm install --no-frozen-lockfile

FROM deps AS build
# The web app imports contract *types* from core, so core source is required
# even though none of it reaches the bundle.
COPY packages/core packages/core
COPY apps/web apps/web

# Empty by default = same-origin. A production image must not bake in a
# developer's loopback; when the API is not same-origin, pass this at build time
# (docker-compose does). An empty value makes the web app call the page's own
# origin, which suits a reverse-proxied deployment.
ARG VITE_BREADCRUMBZ_API_BASE_URL=
ENV VITE_BREADCRUMBZ_API_BASE_URL=$VITE_BREADCRUMBZ_API_BASE_URL

RUN pnpm --filter @ai-fin-os/web build

# ---- Serve ----------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Substitute the API origin into the CSP's connect-src. The build arg is
# re-declared here because ARGs do not cross FROM boundaries. We reduce the
# configured base URL to its scheme://host:port origin (dropping any path); an
# empty value leaves connect-src at 'self' (same-origin), which is correct.
ARG VITE_BREADCRUMBZ_API_BASE_URL=
RUN API_ORIGIN=$(printf '%s' "$VITE_BREADCRUMBZ_API_BASE_URL" | sed -E 's#^([a-zA-Z][a-zA-Z0-9+.-]*://[^/]+).*#\1#') && \
    sed -i "s#__API_ORIGIN__#${API_ORIGIN}#g" /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
