# Public browser-visible API base URL. Do not put secrets in VITE_* values.
VITE_BREADCRUMBZ_API_BASE_URL=http://127.0.0.1:8787

# Optional local Production OAuth testing. Generate localhost.pem and
# localhost-key.pem with mkcert, then run `pnpm run dev:web:https`. The HTTPS
# dev server proxies /api to the local Fastify API, so the browser stays on one
# secure origin. Production Plaid requires the matching https://localhost URI.
# BREADCRUMBZ_DEV_HTTPS=true
