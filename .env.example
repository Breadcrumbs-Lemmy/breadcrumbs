# Copy to .env and fill in. Never commit .env.
#
# Everything here is optional. With none of it set, the API runs in single-user
# mode, CSV import and every spending screen work, and the assistant + Plaid show
# an accurate "not configured" state instead of breaking. Fill in a section to
# turn that capability on.

# ── Server ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
# Comma-separated allowed frontend origins. In development, loopback origins
# (localhost / 127.0.0.1 / [::1]) are auto-allowed, so this can stay empty. In
# production (NODE_ENV=production) loopback is NOT auto-trusted — list your real
# deployed frontend origin(s) here or the browser will be blocked by CORS.
BREADCRUMBS_CORS_ORIGINS=
# Where locally-imported statements and per-user data live. Defaults to
# ~/.breadcrumbs/local-data.
BREADCRUMBS_LOCAL_DATA_DIR=

# ── Authentication ──────────────────────────────────────────────────────────
# single_user (default): no login; every request is the owner. Good for running
#   it just for yourself.
# multi_user: real accounts, per-user isolation, and an admin. The first person
#   to register (or BREADCRUMBS_OWNER_EMAIL) becomes the admin.
BREADCRUMBS_AUTH_MODE=single_user
# In multi_user mode, promote this email to admin when they register.
BREADCRUMBS_OWNER_EMAIL=
# Public registration is OPEN by default in multi_user mode. Set this to exactly
# "closed" to shut it off once your users are seeded (provision further users
# from the admin page). Any other value (or unset) leaves registration open.
BREADCRUMBS_REGISTRATION=

# ── Assistant ───────────────────────────────────────────────────────────────
# Pick one provider. Without either, the assistant is simply off.
#
# anthropic (default): the hosted Claude model. Also transcribes PDF statements.
# local: an OpenAI-compatible model running on THIS machine (Ollama, LM Studio,
#   llama.cpp, …). Its URL must be a loopback address — the server refuses to
#   start a "local" agent pointed anywhere the internet can reach. Handles chat
#   and also imports PDF statements fully offline: the server extracts the PDF's
#   text layer and the local model transcribes it, so nothing leaves the machine.
#   Scanned/image-only PDFs have no text layer and are rejected with a clear
#   message — use the hosted model for those.
#   ("Nothing leaves the machine" holds only while extraction ALSO runs locally.
#   Splitting extraction to the hosted provider — see below — sends a statement's
#   text out on import, and /status reports that separately as extractionOffline.)
BREADCRUMBS_AGENT_PROVIDER=anthropic

# --- Hosted (anthropic) ---
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5.
BREADCRUMBS_AGENT_MODEL=
# Optional: a separate model just for PDF statement extraction. Defaults to
# BREADCRUMBS_AGENT_MODEL. Lets a fast, cheap chat model pair with a stronger
# transcriber for awkward statement layouts.
BREADCRUMBS_EXTRACTION_MODEL=

# --- Local (offline) ---
# e.g. http://127.0.0.1:11434/v1 (Ollama) or http://localhost:1234/v1 (LM Studio)
BREADCRUMBS_LOCAL_AGENT_BASE_URL=
BREADCRUMBS_LOCAL_AGENT_MODEL=
# Optional: a separate, usually larger model just for PDF statement extraction.
# Defaults to BREADCRUMBS_LOCAL_AGENT_MODEL. Chat only phrases pre-computed
# figures, so it can run a small fast model; extraction reads an unfamiliar
# statement layout into rows, where a bigger model helps. e.g. chat=qwen2.5:3b,
# extraction=qwen2.5:32b. (Under Docker, the Ollama sidecar pulls both.)
BREADCRUMBS_LOCAL_EXTRACTION_MODEL=
# Escape hatch: allow a non-loopback local model host (e.g. a trusted LAN box).
# This RELAXES the no-internet guarantee, so it is off by default.
BREADCRUMBS_LOCAL_AGENT_ALLOW_NONLOOPBACK=false

# --- Splitting extraction onto a different provider (optional) ---
# Chat and PDF statement extraction are two jobs. Extraction is narrow and
# well-defined (statement text → rows), so it can run on a DIFFERENT provider
# than chat — e.g. a local, offline chat model paired with a small, cheap HOSTED
# extractor to keep the bill down. Defaults to the chat provider (a no-op unset).
#   PRIVACY: local chat + a hosted extractor means a statement's text leaves the
#   machine on import, even though chat stays on-device. The server logs a warning
#   at startup and /status reports it as extractionOffline=false — the on-device
#   pill in the UI is qualified accordingly.
# "anthropic" or "local". Unset ⇒ same provider as chat.
BREADCRUMBS_EXTRACTION_PROVIDER=
# When the extractor is HOSTED, it reuses ANTHROPIC_API_KEY (above) and its model
# comes from BREADCRUMBS_EXTRACTION_MODEL. Left unset in this mixed config (local
# chat + hosted extractor), it defaults to a small, cheap model rather than the
# big chat default — transcription is a narrow job and this config exists to save
# money. Override to name your own.
# When the extractor is LOCAL and on a different endpoint than chat, set its own
# loopback base URL here (defaults to BREADCRUMBS_LOCAL_AGENT_BASE_URL when chat
# is also local). Its model comes from BREADCRUMBS_LOCAL_EXTRACTION_MODEL.
BREADCRUMBS_LOCAL_EXTRACTION_BASE_URL=
# Escape hatch for a non-loopback extraction host, independent of the chat one.
# Inherited from the chat host only when reusing its endpoint; a distinct URL
# must opt in here. RELAXES the no-internet guarantee, so off by default.
BREADCRUMBS_LOCAL_EXTRACTION_ALLOW_NONLOOPBACK=false

# ── Plaid (connect real bank accounts) ──────────────────────────────────────
# Without these the API runs and CSV import still works.
#
# PLAID_ENV is `sandbox` (test institutions, fake credentials) or `production`
# (real banks, real money). Plaid retired its old "development" tier — those are
# the only two values. Use the matching client id/secret from the Plaid
# dashboard for the environment you pick; production has a different secret than
# sandbox. Linked banks persist under BREADCRUMBS_LOCAL_DATA_DIR/plaid, so they
# survive a restart — keep that directory on durable storage in production.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_CLIENT_NAME=Breadcrumbs
PLAID_COUNTRY_CODES=US
# Required for the OAuth banks most large institutions use (Chase, Wells Fargo,
# etc.): the exact redirect URL you registered in the Plaid dashboard, e.g.
# https://yourdomain.com/. Leave blank in sandbox with non-OAuth test banks.
PLAID_REDIRECT_URI=

# ── Web ─────────────────────────────────────────────────────────────────────
# Where the browser reaches the API. Baked into the web bundle at build time.
VITE_BREADCRUMBS_API_BASE_URL=http://localhost:8787
